  "cards": [
    {
      "dot": "cyan",
      "title": "三路采集各自盯什么",
      "items": [
        "进程树（psutil 轮询）：谁拉起了谁——样本树下的每个新进程都记首次出现",
        "文件（watchdog / inotify）：创建 / 删除 / 修改——批量 .locked 落盘就是加密在进行",
        "网络（连接快照 + C2 陷阱）：远端端点与心跳次数——3 次 /beacon 骗不过去"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么把样本关在容器里",
      "items": [
        "--rm 一次性容器：跑完即弃，宿主上留不下样本的爪印",
        "样本只面对每次现造的 /sandbox 靶目录——炸了就炸了",
        "报告是容器单向交给宿主的唯一产物——经挂载目录落盘后接受断言核验"
      ]
    },
    {
      "dot": "emerald",
      "title": "评分怎么给",
      "items": [
        "7 条规则按危害加权：批量加密 +30、心跳外联 +25、勒索说明 +15……",
        "≥60 判「高度疑似恶意行为」——本样本 115 分",
        "良性对照必须 0 分：检测器先过准入线，再谈检出（与实验 23 同一纪律）"
      ]
    }
  ]
