  "cards": [
    {
      "dot": "cyan",
      "title": "三档黑名单与过法",
      "items": [
        "low 不过滤：分号、管道、反引号、$() 随意",
        "medium 删 && 和 ;：| 与 & 照走，${IFS} 还能当空格",
        "high 再删 |␣、$、( )、反引号：| 后不加空格（|whoami）即存活"
      ]
    },
    {
      "dot": "rose",
      "title": "无回显外带三路",
      "items": [
        "HTTP 外带：curl 把结果送回自己的接收端",
        "DNS 外带：把数据编进域名查询里",
        "时间信道：sleep 0/5 当 0·1 比特逐位问"
      ]
    },
    {
      "dot": "emerald",
      "title": "修复：别再拼 shell",
      "items": [
        "输入白名单：IPv4 就该只接受 IPv4 格式",
        "必须拼时用 escapeshellarg 参数化",
        "Web 进程最小权限（root 是放大器）；出站审计兜底"
      ]
    }
  ]
