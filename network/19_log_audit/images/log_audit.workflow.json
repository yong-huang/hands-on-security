  "cards": [
    {
      "dot": "cyan",
      "title": "验收的三条对账线",
      "items": [
        "植入检出：50 次/60s 触发 R1+R2+R3+R6（≥3 条）",
        "统计对账：Top10 与 awk 手工统计逐条一致",
        "实战检出：真实 DVWA 注入流量被 R3 接住"
      ]
    },
    {
      "dot": "rose",
      "title": "滑动窗口怎么算",
      "items": [
        "时间排序 + 双指针，O(n) 数出「任意 60 秒内最多的失败数」",
        "阈值 30 次可调——散落失败（8 次）不告警（负对照）",
        "窗口与阈值就是告警系统的灵敏度旋钮"
      ]
    },
    {
      "dot": "emerald",
      "title": "从告警到响应",
      "items": [
        "报告给建议动作：封禁、复查口令强度、复核登录成功",
        "实验 20-21 把注入/扫描特征落成 IDS 规则",
        "日志留存与时钟同步，是审计与取证的地基"
      ]
    }
  ]
}
