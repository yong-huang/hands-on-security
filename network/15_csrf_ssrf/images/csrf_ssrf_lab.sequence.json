  "cards": [
    {
      "dot": "cyan",
      "title": "CSRF 为什么成立",
      "items": [
        "受害者已登录——浏览器里躺着会话 cookie",
        "攻击页只需要一个表单：跨站提交也会自动带 cookie",
        "同源策略防「读」，不防「写」——请求照样发得出去"
      ]
    },
    {
      "dot": "rose",
      "title": "referer 检查 vs token",
      "items": [
        "medium 比 Referer：攻击者能声明 referrer-policy、把要的子串放进自己 URL 路径",
        "high 要 user_token：每会话随机的凭证，不读页面就猜不出",
        "结论：让请求「自证读过页面」（token），而不是「听浏览器转述」（referer）"
      ]
    },
    {
      "dot": "emerald",
      "title": "SSRF 的危害与修复",
      "items": [
        "探内网：响应形态/时间/长度差异就是端口扫描（3306 握手脚印）",
        "绕边界：file:// 读本地文件；云环境里直达 metadata 凭证",
        "修复：协议与地址白名单、禁重定向跨段、出站流量审计"
      ]
    }
  ]
}
