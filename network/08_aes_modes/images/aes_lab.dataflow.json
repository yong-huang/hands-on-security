    }
  ],
  "flows": [
    {
      "from": "plain",
      "to": "ecb",
      "label": "同一块反复出现",
      "classification": "模式泄漏的燃料",
      "variant": "emphasis",
      "route": "vertical-channel",
      "labelDy": -20
    },
    {
      "from": "plain",
      "to": "cbc",
