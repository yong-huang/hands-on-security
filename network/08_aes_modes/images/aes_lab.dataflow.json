    },
    {
      "from": "cbc",
      "to": "out_cbc",
      "label": "异或前块密文",
      "classification": "块间纠缠",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": -34
    },
    {
      "from": "out_ecb",
      "to": "leak",
      "label": "统计 + 比对",
      "classification": "选择 ECB 的代价",
      "variant": "security",
      "route": "straight"
    },
    {
      "from": "out_cbc",
      "to": "safe",
      "label": "打散",
      "classification": "推荐姿势",
      "variant": "default",
