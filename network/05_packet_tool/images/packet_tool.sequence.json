  "cards": [
    {
      "dot": "cyan",
      "title": "构造 ≠ 发送",
      "items": [
        "包对象先是内存里的字段树，show() 看到的每层都是它",
        "序列化时才定型长度并计算校验和（构造时是 None）",
        "真正出门由内核与网卡完成，需要 root 与真实接口"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么抓包要特权",
      "items": [
        "/dev/bpf 是特权设备：能看见流过网卡的所有帧",
        "抓「自己发的流量」也占用同一条 BPF 通道",
        "未授权抓包=窃听，授权边界先于技术学习"
      ]
    },
    {
      "dot": "emerald",
      "title": "两种「在线」问法",
      "items": [
        "ARP who-has 在二层：绕过 IP 层过滤，谁答谁在",
        "ICMP echo 在三层：可能被防火墙静默丢弃",
        "ARP 与 ICMP 都复核过的，才是可信的资产清单"
      ]
    }
  ]
}
