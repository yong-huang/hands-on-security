  "cards": [
    {
      "dot": "cyan",
      "title": "三条规则各抓一种形状",
      "items": [
        "EICAR：精确文本串——行业标准测试件，链路验证必备",
        "组合：多串逻辑「1 of 下载 × 1 of 执行」——单看 curl 无罪，合起来才可疑",
        "IP 端点：正则——硬编码 IP + .php 的回连形态"
      ]
    },
    {
      "dot": "rose",
      "title": "白名单降噪的纪律",
      "items": [
        "降噪 = 对「已确认无害」的豁免（EICAR 是标准测试件才配进白名单）",
        "白名单要小而精、定期复核、可追溯——不是遮丑布",
        "成功指标：3/3 检出 + 0 误报，白名单只负责去掉已解释的噪声"
      ]
    },
    {
      "dot": "emerald",
      "title": "性能账",
      "items": [
        "单文件毫秒级；10000 个文件全量扫描 0.4 秒（验收线 30s）",
        "yara 内部多串匹配 + 条件逻辑二次筛选——规则写准就是提性能",
        "扫描器真正的杠杆在规则质量，不在并发花活"
      ]
    }
  ]
