    {
      "dot": "cyan",
      "title": "心跳的四个特征",
      "items": [
        "固定周期 + 低抖动：本实验 30.0±0.15s——统计间隔的均值与标准差即可露头",
        "等长载荷：请求 26B、应答 2B 恒定——内容是加密的，长度没变",
        "固定目的：同一域名、同一 IP 反复回连",
        "检测 = 对（源 IP + 域名）分组后的间隔统计，jitter 小就是嫌疑"
      ]
    },
    {
      "dot": "rose",
      "title": "Zeek 的三段日志",
      "items": [
        "conn.log：谁和谁连了（五元组、时长、流量）",
        "dns.log：查了什么（域名、应答、rcode——DGA 的入口）",
        "http.log：聊了什么（Host/URI/UA——心跳识别的现场）"
      ]
    },
    {
      "dot": "emerald",
      "title": "DGA 与检测边界",
      "items": [
        "随机域名的简化启发式：长标签 + 含数字 + 元音稀少",
        "真实 DGA 会对抗检测（词典拼接、慢速生成）——启发式要配合情报与模型",
        "检出是概率提示不是判决：报告 + 人工复核才是闭环"
      ]
    }
  ]
