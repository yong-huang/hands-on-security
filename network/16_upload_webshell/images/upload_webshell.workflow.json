  "cards": [
    {
      "dot": "cyan",
      "title": "三类校验各信什么",
      "items": [
        "上传请求三件套：内容 / 文件名 / 自称类型（MIME）——校验就在这三样里挑着看",
        "low：什么都不查——文件直接进 Web 目录",
        "medium：信「自称类型」（客户端声明的 MIME，随手可伪造）",
        "high：信「真图 + 白名单扩展名」——图是真的，但图里可以埋 PHP"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么要借文件包含",
      "items": [
        ".jpg 是被当静态资源发的，服务器不会执行它——图马是没点着的炸药",
        "include() 会把任何文件当 PHP 解析——它就是引信",
        "本靶场的包含点要求登录：真实战里攻击者先拿到会话/账号更常见"
      ]
    },
    {
      "dot": "emerald",
      "title": "修复四件套",
      "items": [
        "扩展名白名单 + 服务端重编码图片（剥掉埋在里面的尾巴）",
        "落地文件名随机化，防路径猜测",
        "上传目录禁止脚本解析——传上来也点不着",
        "多重校验并行，别把任何一层当唯一防线"
      ]
    }
  ]
}
