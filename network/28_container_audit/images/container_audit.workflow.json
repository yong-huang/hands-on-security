  "cards": [
    {
      "dot": "cyan",
      "title": "三种「等于宿主 root」的配置",
      "items": [
        "privileged：全部能力 + 设备 + AppArmor 豁免，逃逸即宿主",
        "挂 docker.sock：容器里遥控宿主守护进程，可再起特权容器",
        "host 网络 / PID：拆掉隔离墙，直接看见并伸手到宿主"
      ]
    },
    {
      "dot": "rose",
      "title": "CVE 审计在算什么",
      "items": [
        "镜像每一层里的软件包 × 漏洞库（trivy-db）逐一对账",
        "EOL 镜像 = 189 个 HIGH+；数字随漏洞库漂移，看趋势不看绝对值",
        "库走国内镜像（南大 ghcr 代理 + ECR），首次下载约 1 分钟"
      ]
    },
    {
      "dot": "emerald",
      "title": "加固基线与准入线",
      "items": [
        "--cap-drop ALL；不挂 sock；非 root + --read-only + no-new-privileges",
        "加固容器 0 告警——审计器先证明不误报，再谈抓危险",
        "改完配置用同一审计器回归，才算闭环"
      ]
    }
  ]
