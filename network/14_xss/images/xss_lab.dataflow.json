  "cards": [
    {
      "dot": "cyan",
      "title": "三型的区别在「谁把脚本放进去」",
      "items": [
        "反射：URL 参数 → 服务端回显（要受害者点链接）",
        "存储：入库一次 → 所有访客页面带毒",
        "DOM：payload 只在 URL 里、不参与服务端处理——响应里没有它"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么偷 cookie 可怕",
      "items": [
        "会话 cookie 就是「已登录」的凭证——拿到即可冒充",
        "DVWA 的会话 cookie 未设 HttpOnly，页面脚本直接可读",
        "只偷到 security 档位也行：攻击者能把自己的档位调低"
      ]
    },
    {
      "dot": "emerald",
      "title": "三层修复",
      "items": [
        "输出编码：按输出语境转义（HTML/属性/JS 各不相同）",
        "CSP 限制 script-src，内联脚本直接拦下",
        "Cookie 加 HttpOnly：脚本摸不到凭证"
      ]
    }
  ]
}
