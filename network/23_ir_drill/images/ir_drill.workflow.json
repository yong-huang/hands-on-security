  "cards": [
    {
      "dot": "cyan",
      "title": "五处后门的形状",
      "items": [
        "cron 反弹：/dev/tcp 外连伪装成系统更新任务",
        "UID 0 隐蔽账号：passwd 里多出一个「root 级」用户",
        "authorized_keys：陌生的公钥就是常驻钥匙",
        "隐藏 SUID：点开头的文件名 + setuid 位",
        "history 自证：攻击者自己的操作记录"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么先导出再分析",
      "items": [
        "保全现场：分析只动快照，不碰原机",
        "只读可复算：五路检查与评分可随时复跑对账",
        "mtime 就是证据的时序——时间线还原的地基"
      ]
    },
    {
      "dot": "emerald",
      "title": "评分与准入线",
      "items": [
        "严重 40 / 高 25 / 中 15——本例累计 120 → 高度疑似失陷",
        "干净基线必须 0 误报，检测器才配上岗",
        "报告以行动项收尾：清后门、改密、横向巡检"
      ]
    }
  ]
}
